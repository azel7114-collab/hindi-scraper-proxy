# ============================================
# Hindi Scraper Proxy v4.0 - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# Server port
PORT=3000

# TMDB API key - get free from https://www.themoviedb.org/settings/api
TMDB_API_KEY=75bac74948c44798719aa0f8545905c4

# Request timeout in ms (per-source scraper timeout)
SCRAPER_TIMEOUT=15000

# Cache TTL in seconds (default 30 min)
# Note: stream URLs may expire sooner; keep this low
CACHE_TTL=1800

# CORS allowed origins (* for all)
CORS_ORIGINS=*

# ---- v4.0 NEW: Real Scraper + FlareSolverr ----

# Real scraper (Vegamovies) timeout — how long to wait for HTML scraping
# Default 15s. Real scraping is slower than URL construction.
REAL_SCRAPER_TIMEOUT=15000

# FlareSolverr URL — bypass Cloudflare challenges
# Leave EMPTY to disable (default — direct HTTP for sites that don't use CF).
# Set to enable Cloudflare bypass for vegamovies.* and BollyFlix variants.
#
# Local Docker:
#   FLARESOLVERR_URL=http://localhost:8191/v1
#
# Railway/Hetzner VPS:
#   FLARESOLVERR_URL=http://flaresolverr:8191/v1
#   (using docker-compose service name "flaresolverr")
#
# Render free tier:
#   ✗ Cannot run FlareSolverr — Render free tier has no Docker support
#   ✓ Use Railway ($5/mo) or Hetzner VPS ($4/mo)
FLARESOLVERR_URL=

# FlareSolverr request timeout (ms)
FLARESOLVERR_TIMEOUT=30000

# FlareSolverr retry count on failure
FLARESOLVERR_RETRIES=2

# Enable/disable individual scrapers (true/false)
# PRIMARY: AllMovieLand — backend player used by Vegamovies/BollyFlix/etc.
# Uses IMDb ID directly, no scraping. Most reliable.
ENABLE_ALLMOVIELAND=true

# Real scrapers (Option B)
# Vegamovies.racing - DLE-based, scrapes search results → IMDb ID → AllMovieLand URL
ENABLE_VEGAMOVIES_REAL=true

# Hindi site scrapers (try as fallback if AllMovieLand fails)
# Most of these sites are dead/parked in 2026, kept for backward compat
ENABLE_FZMOVIES=true
ENABLE_BOLLYFLIX=true
ENABLE_MOVIESFLIX=true
ENABLE_HIIDUBA=true

# User-requested additional scrapers (mostly dead)
ENABLE_MLSBD=true
ENABLE_WATCHMOVIES=true
ENABLE_MKVCINEMAS=true
ENABLE_MINOPLRES=true
# WatchHentai is adult content — disabled by default. Set to true to enable.
ENABLE_WATCHHENTAI=false

# Fallback to Multi-Embed providers (VidSrc, 2embed, etc.) if all else fails
ENABLE_MULTIEMBED_FALLBACK=true
